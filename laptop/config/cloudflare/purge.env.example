# Copy to ~/.config/cloudflare/purge.env and run: chmod 600 ~/.config/cloudflare/purge.env
# Never commit the real file.
#
# Zone ID: Cloudflare dashboard > your domain > Overview > API > Zone ID
CF_ZONE=your-zone-id
# API token with only the "Zone > Cache Purge" permission, scoped to that one zone
CF_TOKEN=your-api-token
